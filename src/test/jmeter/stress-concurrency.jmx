def ok = props.getProperty("raceOk"); def c409 = props.getProperty("race409"); def other = props.getProperty("raceOther")
SampleResult.setSuccessful(ok == "1" &amp;&amp; other == "0")
SampleResult.setResponseData("200=" + ok + ", 409=" + c409 + ", 기타=" + other + " (기대: 200=1, 409=N-1, 기타=0)", "UTF-8")
SampleResult.setResponseMessage("성공 " + ok + "건 / 409 " + c409 + "건 / 기타 " + other + "건")
